# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Built artifacts (frontend → backend bundle)
backend/app/static/assets/
backend/app/static/index.html

# Runtime data
data/
output/
*.bak

# Scratch / throwaway artifacts + local PII test docs (never commit real ID/medical scans)
.tmp/
.worktrees/

# Env / secrets
.env
.env.local
deploy/openwa/.env

# Off-DB secret keys — NEVER commit these
data/.vapid_key
data/.email_key

# Editor
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Claude Code locally-installed skills (tooling, not project source)
.claude/skills/
# …but track the hand-authored, team-shared skills (re-include the dir, re-ignore
# every subdir, then allow ours):
!.claude/skills/
.claude/skills/*/
!.claude/skills/db-sync/
!.claude/skills/verify-ui/

# ruflo / claude-flow generated scaffolding + state (tooling, regenerable via `ruflo init upgrade`)
.claude/agents/
.claude/commands/
.claude/helpers/
.claude-flow/
# …but track the hand-authored, team-shared reviewer subagents:
!.claude/agents/
.claude/agents/*
!.claude/agents/bilingual-rtl-reviewer.md
!.claude/agents/migration-parity-reviewer.md

# Stray bootstrap binary (uv copy used to rebuild venv)
/uv.exe

# Logs (uvicorn dev output, npm, etc.)
*.log

# Playwright MCP debug artifacts (console logs, page snapshots, screenshots)
.playwright-mcp/

# Playwright run output and review screenshots (heavy PNG evidence, regenerated
# by `playwright test e2e/attendance-shots.spec.ts`; the verification record in
# docs/ is what stays tracked - same policy as audit-report/screens below).
frontend/test-results/
frontend/e2e/__screenshots__/

# Design handoff bundles (Claude Design exports — not source)
GSSG Manager Design System-handoff/
GSSG Manager Design System-handoff.zip
.design-package/

# Audit verification screenshots (heavy PNG evidence — findings .md + index.html stay tracked)
audit-report/screens/

# Captures of the live app (real employee names, G-numbers, leave and medical
# history). These are PII in a PUBLIC repository, so they never get committed -
# not by hand and not by a broad `git add docs`. Same policy as the screenshot
# directories above; regenerate them locally from docs/how-we-work/capture.mjs.
docs/how-we-work/shots/
docs/how-we-work/*.pdf
docs/repro/*.png
docs/org-chart/work/

# Skill scratch dirs + one-off review/report artifacts (heavy, not source)
.superpowers/brainstorm/
*-report.html
*-review.html
report-assets/
audit-report/weekly-health-*.html
app-form-leave.yml
.superpowers/

# impeccable /live session state (local tooling)
**/.impeccable/

# Generated API schema (regenerated by scripts/build.ps1)
backend/openapi.json

# graphify knowledge-graph output (derived, ~28 MB; rebuild with /graphify)
graphify-out/

# swarm agent memory (binary tool state)
.swarm/

# design mockup screenshots and reference images (large binaries, local only)
mockups/shots/
mockups/refreance/

# org-chart reverse-engineering evidence (third-party captures, local only)
docs/org-chart/work/
