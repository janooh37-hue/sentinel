{
  "description": "Production safety and focused checks for GSSG Manager.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/pre-deploy.ps1'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 15,
            "statusMessage": "Checking production deploy safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.herdr/hooks/notify-plan-stop.ps1'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 20,
            "statusMessage": "Notifying pipeline orchestrator"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/post-edit.ps1'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 90,
            "statusMessage": "Checking edited files"
          }
        ]
      }
    ]
  }
}
