#!/bin/sh
# Branch `dev` is a rebuildable preview: origin/main plus the feature branches
# under test (scripts/dev-channel.ps1). Every rebuild resets it, so a commit made
# here is lost, and the branch that goes to main would not contain it.
# Merges are how branches arrive on dev, so a merge in progress may be committed.
# Enabled per clone with: git config core.hooksPath .githooks
[ "$(git branch --show-current)" = dev ] || exit 0
git rev-parse -q --verify MERGE_HEAD >/dev/null && exit 0
cat >&2 <<'EOF'
Not committed: branch `dev` is a preview, not a place to work.
Make this change in the feature branch's own worktree, commit and push it there,
then show it on the dev URL with: scripts\dev-channel.ps1 preview <branch>
See .agents/skills/dev-cycle/SKILL.md.
EOF
exit 1
