# Copy to .env in the active feature worktree. Never copy the production .env.
# All worktrees use this one laptop-only snapshot; dev edits are disposable.
GSSG_DATA_DIR=C:\Users\GSSG\gssg-dev-data
GSSG_HOST=127.0.0.1
GSSG_PORT=8765
GSSG_DEV_MODE=1
GSSG_DISABLE_SCHEDULER=1
# Required when Tailscale Serve terminates HTTPS for the login cookie.
GSSG_SECURE_COOKIES=1
# No GSSG_SMS_*, GSSG_OPENWA_*, or GSSG_BIOTIME_* settings.
