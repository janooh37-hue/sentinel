<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProductVersion Condition=" '$(ProductVersion)' == '' ">$(GSSG_OUTLOOK_PRODUCT_VERSION)</ProductVersion>
    <ProjectGuid>{F0D9D3D1-E8A3-4D52-9C10-7F1A97B68C5A}</ProjectGuid>
    <OutputName>Gssg.Outlook.Launcher</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\$(Platform)\</OutputPath>
    <SentinelOrigin Condition=" '$(SentinelOrigin)' == '' ">$(GSSG_SENTINEL_ORIGIN)</SentinelOrigin>
    <DefineConstants>SentinelOrigin=$(SentinelOrigin);Platform=$(Platform);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Product.wxs" />
    <ProjectReference Include="..\src\Gssg.Outlook.Launcher\Gssg.Outlook.Launcher.csproj">
      <Project>{B635CA15-F233-4A12-9A3B-4C4E47B9034B}</Project>
      <Name>Gssg.Outlook.Launcher</Name>
      <Private>True</Private>
    </ProjectReference>
    <ProjectReference Include="..\src\Gssg.Outlook.AddIn\Gssg.Outlook.AddIn.csproj">
      <Project>{7B8F8C4A-9C84-4A8A-9E6A-0C6A8C7A4B21}</Project>
      <Name>Gssg.Outlook.AddIn</Name>
      <Private>True</Private>
    </ProjectReference>
    <ProjectReference Include="..\src\Gssg.Outlook.Shared\Gssg.Outlook.Shared.csproj">
      <Project>{3E968C2F-6DB7-4F54-8C77-7D3EC5450A01}</Project>
      <Name>Gssg.Outlook.Shared</Name>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <Target Name="ValidateProductVersion" BeforeTargets="Compile">
    <Error Condition=" '$(ProductVersion)' == '' " Text="ProductVersion is required; supply a monotonically increasing MSI version with /p:ProductVersion=x.y.z.w." />
  </Target>
  <Target Name="ValidateSentinelOrigin" BeforeTargets="Compile">
    <Error Condition=" '$(SentinelOrigin)' == '' " Text="SentinelOrigin is required. Pass /p:SentinelOrigin with the deployment HTTPS origin; the installer never supplies a fallback origin." />
  </Target>
  <Import Project="$(WixTargetsPath)" Condition=" '$(WixTargetsPath)' != '' " />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\WiX\v3.x\Wix.targets" Condition=" '$(WixTargetsPath)' == '' AND Exists('$(MSBuildExtensionsPath32)\Microsoft\WiX\v3.x\Wix.targets') " />
</Project>
