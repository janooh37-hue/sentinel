<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
<?if $(var.Platform) = x64 ?>
<?define ComponentWin64 = "yes" ?>
<?else ?>
<?define ComponentWin64 = "no" ?>
<?endif ?>
  <Product Id="*" Name="GSSG Manager Outlook Bridge" Language="1033" Version="1.0.0.0" Manufacturer="GSSG Manager" UpgradeCode="7D207C60-DF08-4D57-B2C5-3D7AA25A3A34">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="$(var.Platform)" />
    <MajorUpgrade DowngradeErrorMessage="A newer GSSG Manager Outlook Bridge is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
<?if $(var.Platform) = x64 ?>
      <Directory Id="ProgramFiles64Folder">
<?else ?>
      <Directory Id="ProgramFilesFolder">
<?endif ?>
        <Directory Id="GssgManagerFolder" Name="GSSG Manager">
          <Directory Id="INSTALLFOLDER" Name="Outlook Bridge" />
        </Directory>
<?if $(var.Platform) = x64 ?>
      </Directory>
<?else ?>
      </Directory>
<?endif ?>
    </Directory>

    <Feature Id="Complete" Title="GSSG Manager Outlook Bridge" Level="1">
      <ComponentRef Id="LauncherComponent" />
      <ComponentRef Id="ConfigurationComponent" />
      <ComponentRef Id="ProtocolComponent" />
    </Feature>

    <Component Id="LauncherComponent" Directory="INSTALLFOLDER" Guid="*" Win64="$(var.ComponentWin64)">
      <File Id="LauncherExe" Source="$(var.Gssg.Outlook.Launcher.TargetPath)" KeyPath="yes" />
    </Component>

    <Component Id="ConfigurationComponent" Directory="INSTALLFOLDER" Guid="*" Win64="$(var.ComponentWin64)">
      <RegistryKey Root="HKLM" Key="Software\GSSG Manager\Outlook Bridge">
        <RegistryValue Name="SentinelOrigin" Type="string" Value="$(var.SentinelOrigin)" KeyPath="yes" />
      </RegistryKey>
    </Component>

    <Component Id="ProtocolComponent" Directory="INSTALLFOLDER" Guid="*" Win64="$(var.ComponentWin64)">
      <RegistryKey Root="HKCR" Key="gssg-outlook">
        <RegistryValue Name="URL Protocol" Type="string" Value="" KeyPath="yes" />
        <RegistryValue Name="" Type="string" Value="URL:GSSG Manager Outlook Bridge" />
        <RegistryKey Key="shell\open\command">
          <RegistryValue Name="" Type="string" Value="&quot;[INSTALLFOLDER]Gssg.Outlook.Launcher.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>
  </Product>
</Wix>
